# ─── LLM Provider API Keys ───────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ─── Data Acquisition API Keys ───────────────────────────────────
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# ─── Kaggle Credentials ─────────────────────────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=

# ─── Vector Store ────────────────────────────────────────────────
PINECONE_API_KEY=

# ─── Observability (Langfuse) ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ─── Application Config ─────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
VECTOR_STORE_PATH=./data/vector_store
SCRAPING_DELAY_MIN=1
SCRAPING_DELAY_MAX=3
# Comma-separated allowed CORS origins. Add your production domain here.
# CORS_ORIGINS=https://your-production-domain.com,http://localhost:5173
